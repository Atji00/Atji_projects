{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "fricfactory"
		},
		"FricDataLakeStorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'FricDataLakeStorage'"
		},
		"FricSqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FricSqlDatabase'"
		},
		"FricDataLakeStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://fricdatalake.dfs.core.windows.net/"
		},
		"FricSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "fric00.database.windows.net"
		},
		"FricSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "fricSqlDatabase"
		},
		"FricSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminfric"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "fricfactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"FricDataLakeStorage_accountKey": {
						"value": "[parameters('FricDataLakeStorage_accountKey')]"
					},
					"FricSqlDatabase_password": {
						"value": "[parameters('FricSqlDatabase_password')]"
					},
					"FricDataLakeStorage_properties_typeProperties_url": {
						"value": "[parameters('FricDataLakeStorage_properties_typeProperties_url')]"
					},
					"FricSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('FricSqlDatabase_properties_typeProperties_server')]"
					},
					"FricSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('FricSqlDatabase_properties_typeProperties_database')]"
					},
					"FricSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('FricSqlDatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "fricfactory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'fricfactory_ArmTemplate_0')]"
			]
		}
	]
}