{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "fricfactory"
		},
		"FricDataLakeStorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'FricDataLakeStorage'"
		},
		"FricSqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FricSqlDatabase'"
		},
		"FricDataLakeStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://fricdatalake.dfs.core.windows.net/"
		},
		"FricSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "fric00.database.windows.net"
		},
		"FricSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "fricSqlDatabase"
		},
		"FricSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminfric"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/FricDataLakeStorage')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('FricDataLakeStorage_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('FricDataLakeStorage_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/FricSqlDatabase')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('FricSqlDatabase_properties_typeProperties_server')]",
					"database": "[parameters('FricSqlDatabase_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('FricSqlDatabase_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('FricSqlDatabase_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ADL_Clients')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "FricDataLakeStorage",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "ADL(AzureDataLake)-Tables"
				},
				"annotations": [],
				"type": "Excel",
				"typeProperties": {
					"sheetName": "clients",
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "clients.xls",
						"fileSystem": "datalake"
					},
					"firstRowAsHeader": true
				},
				"schema": [
					{
						"type": "String"
					},
					{
						"type": "String"
					},
					{
						"type": "String"
					},
					{
						"type": "String"
					},
					{
						"type": "String"
					},
					{
						"type": "String"
					},
					{
						"type": "String"
					}
